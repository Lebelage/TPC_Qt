{
  "name": "tpc-qt",
  "version-string": "0.1.0",
  "description": "Qt application for TPC control and magnetic-field visualization",
  "dependencies": [
    "eigen3",
    "nlohmann-json",
    "open62541pp",
    "stdexec",
    {
      "name": "qtbase",
      "default-features": false,
      "features": [
        "concurrent",
        "gui",
        "widgets",
        "network",
        "dnslookup",
        "opengl",
        "png",
        "jpeg",
        "thread",
        {
          "name": "framework",
          "platform": "osx"
        },
        {
          "name": "windeployqt",
          "platform": "windows"
        }
      ]
    },
    {
      "name": "qtdeclarative",
      "default-features": false
    }
  ]
}
