{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Meson: configure Windows Debug",
            "type": "process",
            "command": "meson",
            "args": [
                "setup",
                "${workspaceFolder}/.build/meson-windows-${input:windowsArch}-debug",
                "--buildtype=debug",
                "--cross-file",
                "${workspaceFolder}/meson/cross/windows-${input:windowsArch}.ini"
            ],
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": []
        },
        {
            "label": "Meson: build Windows Debug",
            "type": "process",
            "command": "meson",
            "args": ["compile", "-C", "${workspaceFolder}/.build/meson-windows-${input:windowsArch}-debug", "deploy"],
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": "$msCompile",
            "dependsOn": "Meson: configure Windows Debug",
            "group": { "kind": "build", "isDefault": true }
        },
        {
            "label": "Meson: run Windows Debug",
            "type": "process",
            "command": "${workspaceFolder}/.build/meson-windows-${input:windowsArch}-debug/TPC_Qt.exe",
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": [],
            "dependsOn": "Meson: build Windows Debug"
        },
        {
            "label": "Meson: configure Windows Release",
            "type": "process",
            "command": "meson",
            "args": [
                "setup",
                "${workspaceFolder}/.build/meson-windows-${input:windowsArch}-release",
                "--buildtype=release",
                "--cross-file",
                "${workspaceFolder}/meson/cross/windows-${input:windowsArch}.ini"
            ],
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": []
        },
        {
            "label": "Meson: build Windows Release",
            "type": "process",
            "command": "meson",
            "args": ["compile", "-C", "${workspaceFolder}/.build/meson-windows-${input:windowsArch}-release", "deploy"],
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": "$msCompile",
            "dependsOn": "Meson: configure Windows Release",
            "group": "build"
        },
        {
            "label": "Meson: run Windows Release",
            "type": "process",
            "command": "${workspaceFolder}/.build/meson-windows-${input:windowsArch}-release/TPC_Qt.exe",
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": [],
            "dependsOn": "Meson: build Windows Release"
        },
        {
            "label": "Meson: package Windows",
            "type": "process",
            "command": "meson",
            "args": ["compile", "-C", "${workspaceFolder}/.build/meson-windows-${input:windowsArch}-release", "package"],
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": "$msCompile",
            "dependsOn": "Meson: configure Windows Release"
        },
        {
            "label": "Meson: configure macOS Debug",
            "type": "process",
            "command": "meson",
            "args": ["setup", "${workspaceFolder}/.build/meson-macos-native-debug", "--buildtype=debug"],
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": []
        },
        {
            "label": "Meson: build macOS Debug",
            "type": "process",
            "command": "meson",
            "args": ["compile", "-C", "${workspaceFolder}/.build/meson-macos-native-debug", "deploy"],
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": "$gcc",
            "dependsOn": "Meson: configure macOS Debug",
            "group": { "kind": "build", "isDefault": true }
        },
        {
            "label": "Meson: run macOS Debug",
            "type": "process",
            "command": "${workspaceFolder}/.build/meson-macos-native-debug/TPC_Qt.app/Contents/MacOS/TPC_Qt",
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": [],
            "dependsOn": "Meson: build macOS Debug"
        },
        {
            "label": "Meson: configure macOS Release",
            "type": "process",
            "command": "meson",
            "args": ["setup", "${workspaceFolder}/.build/meson-macos-native-release", "--buildtype=release"],
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": []
        },
        {
            "label": "Meson: build macOS Release",
            "type": "process",
            "command": "meson",
            "args": ["compile", "-C", "${workspaceFolder}/.build/meson-macos-native-release", "deploy"],
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": "$gcc",
            "dependsOn": "Meson: configure macOS Release",
            "group": "build"
        },
        {
            "label": "Meson: run macOS Release",
            "type": "process",
            "command": "${workspaceFolder}/.build/meson-macos-native-release/TPC_Qt.app/Contents/MacOS/TPC_Qt",
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": [],
            "dependsOn": "Meson: build macOS Release"
        },
        {
            "label": "Meson: package macOS",
            "type": "process",
            "command": "meson",
            "args": ["compile", "-C", "${workspaceFolder}/.build/meson-macos-native-release", "package"],
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": "$gcc",
            "dependsOn": "Meson: configure macOS Release"
        },
        {
            "label": "Meson: clean Windows",
            "type": "process",
            "command": "meson",
            "args": ["compile", "-C", "${workspaceFolder}/.build/meson-windows-${input:windowsArch}-${input:buildType}", "--clean"],
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": "$msCompile"
        },
        {
            "label": "Meson: clean macOS",
            "type": "process",
            "command": "meson",
            "args": ["compile", "-C", "${workspaceFolder}/.build/meson-macos-native-${input:buildType}", "--clean"],
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": "$gcc"
        }
    ],
    "inputs": [
        {
            "id": "windowsArch",
            "type": "pickString",
            "description": "Целевая архитектура Windows",
            "options": ["x86_64", "arm64"],
            "default": "x86_64"
        },
        {
            "id": "buildType",
            "type": "pickString",
            "description": "Конфигурация сборки",
            "options": ["debug", "release"],
            "default": "debug"
        }
    ]
}
