{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "common",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/.build/${presetName}",
      "installDir": "${sourceDir}/out/${presetName}",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "warnings": {
        "dev": true,
        "deprecated": true,
        "uninitialized": false,
        "unusedCli": true,
        "systemVars": false
      },
      "cacheVariables": {
        "BUILD_TESTING": "OFF",
        "TPC_INSTALL": "OFF",
        "TPC_SLINT_USE_INSTALLED_TPC": "OFF",
        "TPC_API_DIR": "${sourceDir}/subprojects/tpc_api",
        "VCPKG_APPLOCAL_DEPS": "ON"
      },
      "environment": {
        "VCPKG_DISABLE_METRICS": "1"
      }
    },
    {
      "name": "debug-mode",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_INTERPROCEDURAL_OPTIMIZATION": "OFF",
        "TPC_SLINT_COMPACT_RELEASE": "OFF",
        "TPC_SLINT_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "release-mode",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_INTERPROCEDURAL_OPTIMIZATION": "ON",
        "TPC_SLINT_COMPACT_RELEASE": "ON",
        "TPC_SLINT_EXPORT_COMPILE_COMMANDS": "OFF"
      }
    },
    {
      "name": "macos",
      "hidden": true,
      "inherits": "common",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      },
      "environment": {
        "PATH": "/opt/homebrew/bin:/usr/local/bin:$penv{PATH}"
      }
    },
    {
      "name": "windows",
      "hidden": true,
      "inherits": "common",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "debug",
      "displayName": "Debug (macOS)",
      "description": "Debug build with symbols and compile_commands.json",
      "inherits": ["macos", "debug-mode"]
    },
    {
      "name": "release",
      "displayName": "Release (macOS)",
      "description": "Size-optimized Release build with link-time optimization",
      "inherits": ["macos", "release-mode"]
    },
    {
      "name": "windows-debug",
      "displayName": "Debug (Windows)",
      "description": "Debug build with symbols and compile_commands.json",
      "inherits": ["windows", "debug-mode"]
    },
    {
      "name": "windows-release",
      "displayName": "Release (Windows)",
      "description": "Size-optimized Release build with link-time optimization",
      "inherits": ["windows", "release-mode"]
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "displayName": "Build Debug (macOS)",
      "configurePreset": "debug",
      "targets": [
        "TPC_Slint"
      ]
    },
    {
      "name": "release",
      "displayName": "Build Release (macOS)",
      "configurePreset": "release",
      "targets": [
        "TPC_Slint"
      ]
    },
    {
      "name": "package",
      "displayName": "Package Release (macOS)",
      "configurePreset": "release",
      "targets": [
        "install"
      ]
    },
    {
      "name": "windows-debug",
      "displayName": "Build Debug (Windows)",
      "configurePreset": "windows-debug",
      "targets": [
        "TPC_Slint"
      ]
    },
    {
      "name": "windows-release",
      "displayName": "Build Release (Windows)",
      "configurePreset": "windows-release",
      "targets": [
        "TPC_Slint"
      ]
    },
    {
      "name": "windows-package",
      "displayName": "Package Release (Windows)",
      "configurePreset": "windows-release",
      "targets": [
        "install"
      ]
    }
  ]
}
