{
  "version": 10,
  "cmakeMinimumRequired": {
    "major": 4,
    "minor": 4,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "CMAKE_PREFIX_PATH": "$env{HOME}/Qt/6.11.2/macos",
        "BUILD_TESTING": "OFF",
        "TPC_INSTALL": "OFF"
      }
    },
    {
      "name": "debug",
      "displayName": "Debug",
      "description": "Debug build; build metadata stays in .build/debug",
      "inherits": "base",
      "binaryDir": "${sourceDir}/.build/debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "TPC_QT_OUTPUT_DIR": "${sourceDir}/out/debug",
        "TPC_QT_EXPORT_COMPILE_COMMANDS": "ON",
        "TPC_QT_COMPACT_RELEASE": "OFF"
      }
    },
    {
      "name": "release",
      "displayName": "Release (compact)",
      "description": "Size-optimized Release; only the runnable application goes to out/release",
      "inherits": "base",
      "binaryDir": "${sourceDir}/.build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_INTERPROCEDURAL_OPTIMIZATION": "ON",
        "TPC_QT_OUTPUT_DIR": "${sourceDir}/out/release",
        "TPC_QT_EXPORT_COMPILE_COMMANDS": "OFF",
        "TPC_QT_COMPACT_RELEASE": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "displayName": "Build Debug",
      "configurePreset": "debug",
      "targets": [
        "TPC_Qt"
      ]
    },
    {
      "name": "release",
      "displayName": "Build compact Release",
      "configurePreset": "release",
      "targets": [
        "TPC_Qt"
      ]
    }
  ]
}
