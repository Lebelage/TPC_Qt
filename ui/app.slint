export { FieldWindow, MapTick, MapSensor } from "field-window.slint";
export { SensorRow } from "sensor-table.slint";
import { SensorTable, SensorRow } from "sensor-table.slint";
import { SettingsPage } from "settings-page.slint";
import { DiagnosticsPanel } from "diagnostics-panel.slint";
import { Theme } from "theme.slint";
import {
    AppButton, FieldBadge, MetricCard, NavButton, PageTitle, Panel, StatusDot
} from "components.slint";

export component MainWindow inherits Window {
    title: "TPC Field Console";
    preferred-width: 1080px;
    preferred-height: 680px;
    min-width: 860px;
    min-height: 560px;
    background: Theme.canvas;
    default-font-family: Theme.font-family;
    default-font-size: Theme.font-body;

    in property <[SensorRow]> sensor-rows;
    in-out property <int> current-tab: 0;
    in property <bool> connected: false;
    in property <bool> field-calculated: false;
    in property <bool> calculating: false;
    in property <int> enabled-sensor-count: 0;
    in-out property <string> settings-path;
    in property <string> active-settings-path;
    in property <string> settings-file-name;
    in property <string> data-quality: "Waiting for selected sensor channels";
    in property <string> field-quality: "No verified reconstruction";
    in property <bool> homogeneous: false;
    in-out property <string> tpc-length: "4058";
    in-out property <string> tpc-radius: "1408.569";
    in-out property <string> endpoint: "opc.tcp://127.0.0.1:4840";
    in-out property <string> polling-interval: "100";
    in-out property <string> grid-nx: "10";
    in-out property <string> grid-ny: "10";
    in-out property <string> grid-nz: "10";
    in-out property <string> status-message: "Ready";
    in property <int> status-level: 0;

    callback connect-requested();
    callback disconnect-requested();
    callback calculate-field();
    callback visualize-field();
    callback save-field();
    callback load-settings();
    callback browse-settings();
    callback load-settings-file(string);
    callback sensor-toggled(string, bool);
    callback apply-settings(string, string, string, string, string, string, string);

    HorizontalLayout {
        spacing: 0px;

        Rectangle {
            width: 200px;
            background: Theme.sidebar;
            border-color: Theme.border;
            border-width: 1px;

            VerticalLayout {
                padding: 14px;
                spacing: 6px;

                HorizontalLayout {
                    height: 48px;
                    spacing: 9px;
                    Rectangle {
                        width: 34px;
                        height: 34px;
                        border-radius: 8px;
                        background: Theme.accent;
                        Text {
                            text: "B";
                            color: white;
                            font-size: Theme.font-heading;
                            font-weight: Theme.weight-bold;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                    VerticalLayout {
                        spacing: 0px;
                        Text { text: "TPC"; color: Theme.text; font-size: Theme.font-heading; font-weight: Theme.weight-bold; vertical-alignment: bottom; }
                        Text { text: "FIELD CONSOLE"; color: Theme.text-subtle; font-size: Theme.font-small; font-weight: Theme.weight-bold; letter-spacing: 0.4px; vertical-alignment: top; }
                    }
                }

                Text { text: "NAVIGATION"; color: Theme.text-subtle; font-size: Theme.font-small; font-weight: Theme.weight-bold; letter-spacing: 0.4px; height: 20px; vertical-alignment: bottom; }
                NavButton { text: "Workspace"; symbol: "◎"; selected: root.current-tab == 0; clicked => { root.current-tab = 0; } }
                NavButton { text: "Settings"; symbol: "⌁"; selected: root.current-tab == 1; clicked => { root.current-tab = 1; } }

                Rectangle { vertical-stretch: 1; background: transparent; }

                Panel {
                    height: 128px;
                    VerticalLayout {
                        padding: 10px;
                        spacing: 7px;
                        HorizontalLayout {
                            height: 18px;
                            spacing: 7px;
                            Rectangle {
                                width: 9px;
                                background: transparent;
                                StatusDot { y: (parent.height - self.height) / 2; online: root.connected; }
                            }
                            Text {
                                text: root.connected ? "TPC online" : "TPC offline";
                                color: root.connected ? Theme.success : Theme.text-muted;
                                font-size: Theme.font-label;
                                font-weight: Theme.weight-medium;
                                vertical-alignment: center;
                            }
                        }
                        Text {
                            text: root.connected ? "Receiving live sensor data" : "No active OPC UA session";
                            color: Theme.text-subtle;
                            font-size: Theme.font-caption;
                            wrap: word-wrap;
                        }
                        AppButton {
                            height: Theme.control-height;
                            text: root.connected ? "Disconnect" : "Connect";
                            primary: !root.connected;
                            clicked => {
                                if root.connected { root.disconnect-requested(); }
                                else { root.connect-requested(); }
                            }
                        }
                    }
                }
            }
        }

        Rectangle {
            horizontal-stretch: 1;
            background: Theme.canvas;

            if root.current-tab == 0: VerticalLayout {
                padding: Theme.padding;
                spacing: 10px;

                HorizontalLayout {
                    height: 52px;
                    PageTitle {
                        title: "Sensor workspace";
                        subtitle: "Live magnetic field components and sensor geometry";
                        horizontal-stretch: 1;
                    }
                    Rectangle {
                        width: 112px;
                        background: transparent;
                        FieldBadge {
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            ready: root.field-calculated;
                        }
                    }
                }

                HorizontalLayout {
                    height: 88px;
                    spacing: 10px;
                    MetricCard {
                        horizontal-stretch: 1;
                        label: "SENSORS";
                        value: root.enabled-sensor-count + " / " + root.sensor-rows.length;
                        detail: "Used / configured";
                        value-color: Theme.accent-hover;
                    }
                    MetricCard {
                        horizontal-stretch: 1;
                        label: "CONNECTION";
                        value: root.connected ? "Online" : "Offline";
                        detail: root.connected ? "OPC UA session active" : "Waiting for connection";
                        value-color: root.connected ? Theme.success : Theme.text-muted;
                    }
                    MetricCard {
                        horizontal-stretch: 1;
                        label: "FIELD MODEL";
                        value: root.field-calculated ? "Ready" : "Pending";
                        detail: root.field-calculated ? "Slices available" : "Run a field calculation";
                        value-color: root.field-calculated ? Theme.success : Theme.warning;
                    }
                }

                SensorTable {
                    vertical-stretch: 1;
                    rows: root.sensor-rows;
                    busy: root.calculating;
                    sensor-toggled(name, enabled) => { root.sensor-toggled(name, enabled); }
                }

                HorizontalLayout {
                    height: Theme.control-height;
                    spacing: 8px;
                    Rectangle { horizontal-stretch: 1; background: transparent; }
                    AppButton { text: "Export VTK"; active: root.field-calculated; clicked => { root.save-field(); } }
                    AppButton { text: "Open slices"; active: root.field-calculated; clicked => { root.visualize-field(); } }
                    AppButton { text: root.calculating ? "Calculating…" : "Calculate field"; active: !root.calculating; primary: true; clicked => { root.calculate-field(); } }
                }
                DiagnosticsPanel {
                    message: root.status-message;
                    level: root.status-level;
                    data-quality: root.data-quality;
                    field-quality: root.field-quality;
                    homogeneous: root.homogeneous;
                }
            }

            if root.current-tab == 1: SettingsPage {
                tpc-length <=> root.tpc-length;
                tpc-radius <=> root.tpc-radius;
                endpoint <=> root.endpoint;
                polling-interval <=> root.polling-interval;
                grid-nx <=> root.grid-nx;
                grid-ny <=> root.grid-ny;
                grid-nz <=> root.grid-nz;
                settings-path <=> root.settings-path;
                active-settings-path: root.active-settings-path;
                settings-file-name: root.settings-file-name;
                busy: root.calculating;
                reload => { root.load-settings(); }
                browse => { root.browse-settings(); }
                load-file(path) => { root.load-settings-file(path); }
                apply => {
                    root.apply-settings(root.tpc-length, root.tpc-radius, root.endpoint,
                        root.polling-interval, root.grid-nx, root.grid-ny, root.grid-nz);
                }
            }
        }
    }
}
