export global Theme {
    out property <brush> canvas: #0b0f17;
    out property <brush> sidebar: #0f1520;
    out property <brush> surface: #141b27;
    out property <brush> surface-raised: #1a2332;
    out property <brush> surface-hover: #202b3c;
    out property <brush> border: #283548;
    out property <brush> border-strong: #36465d;

    out property <brush> text: #edf3fb;
    out property <brush> text-muted: #94a3b8;
    out property <brush> text-subtle: #64748b;

    out property <brush> accent: #5b8cff;
    out property <brush> accent-hover: #73a0ff;
    out property <brush> accent-soft: #1c315a;
    out property <brush> success: #45d19a;
    out property <brush> success-soft: #153c35;
    out property <brush> warning: #f3b95f;
    out property <brush> danger: #ff6b7a;
}
