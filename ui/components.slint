import { CheckBox } from "std-widgets.slint";
import { Theme } from "theme.slint";

export component Panel inherits Rectangle {
    background: Theme.surface;
    border-color: Theme.border;
    border-width: 1px;
    border-radius: Theme.radius;
}

export component BodyText inherits Text {
    color: Theme.text;
    font-size: Theme.font-body;
    font-weight: Theme.weight-normal;
}

export component CaptionText inherits BodyText {
    color: Theme.text-muted;
    font-size: Theme.font-caption;
}

export component SectionTitle inherits BodyText {
    font-size: Theme.font-heading;
    font-weight: Theme.weight-bold;
}

export component FormLabel inherits BodyText {
    color: Theme.text-muted;
    font-size: Theme.font-label;
    font-weight: Theme.weight-medium;
    vertical-alignment: center;
}

export component SettingsCard inherits Panel {
    in property <string> title;
    in property <string> description;
    VerticalLayout {
        padding: Theme.padding;
        spacing: Theme.gap;
        SectionTitle { text: root.title; }
        CaptionText { text: root.description; wrap: word-wrap; }
        @children
    }
}

export component PageTitle inherits VerticalLayout {
    in property <string> title;
    in property <string> subtitle;
    spacing: 3px;
    Text { text: root.title; color: Theme.text; font-size: Theme.font-title; font-weight: Theme.weight-bold; }
    Text { text: root.subtitle; color: Theme.text-muted; font-size: Theme.font-label; font-weight: Theme.weight-normal; }
}

export component MutedLabel inherits BodyText {
    color: Theme.text-muted;
    font-size: Theme.font-body;
    vertical-alignment: center;
}

export component AppButton inherits Rectangle {
    in property <string> text;
    in property <bool> primary: false;
    in property <bool> active: true;
    callback clicked();

    preferred-width: max(88px, button-label.preferred-width + 28px);
    height: Theme.control-height;
    border-radius: Theme.control-radius;
    border-width: 1px;
    border-color: root.primary ? Theme.accent : Theme.border-strong;
    background: !root.active ? Theme.surface-raised
        : touch.pressed ? (root.primary ? Theme.accent-pressed : Theme.control-pressed)
        : touch.has-hover ? (root.primary ? Theme.accent-hover : Theme.surface-hover)
        : root.primary ? Theme.accent : Theme.surface-raised;

    accessible-role: button;
    accessible-label: root.text;
    accessible-enabled: root.active;

    button-label := Text {
        text: root.text;
        color: !root.active ? Theme.text-subtle : root.primary ? white : Theme.text;
        font-size: Theme.font-label;
        font-weight: Theme.weight-medium;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        enabled: root.active;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component SensorToggle inherits Rectangle {
    in property <bool> checked;
    in property <bool> active: true;
    in property <string> sensor-name;
    callback toggled(bool);
    background: transparent;
    CheckBox {
        x: 0px; y: 0px; width: 22px; height: root.height;
        checked: root.checked;
        enabled: root.active;
        accessible-label: "Include " + root.sensor-name + " in reconstruction";
        toggled => { root.toggled(self.checked); }
    }
    Rectangle {
        x: 28px; y: 0px; width: 36px; height: root.height; background: transparent;
        Text {
            text: root.checked ? "ON" : "OFF";
            color: root.active ? Theme.text : Theme.text-muted;
            font-size: Theme.font-caption; font-weight: Theme.weight-medium; vertical-alignment: center;
        }
        TouchArea { enabled: root.active; mouse-cursor: pointer; clicked => { root.toggled(!root.checked); } }
    }
}

export component NavButton inherits Rectangle {
    in property <string> text;
    in property <string> symbol;
    in property <bool> selected: false;
    callback clicked();

    height: 44px;
    border-radius: 7px;
    background: root.selected ? Theme.accent-soft : nav-touch.has-hover ? Theme.surface-hover : transparent;
    accessible-role: button;
    accessible-label: root.text;

    Rectangle {
        x: 0;
        y: 7px;
        width: 3px;
        height: parent.height - 14px;
        border-radius: 2px;
        background: root.selected ? Theme.accent : transparent;
    }

    HorizontalLayout {
        padding-left: 11px;
        padding-right: 10px;
        spacing: 8px;
        Text {
            text: root.symbol;
            color: root.selected ? #a9c2ff : Theme.text-subtle;
            font-size: Theme.font-body;
            width: 19px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        Text {
            text: root.text;
            color: root.selected ? Theme.text : Theme.text-muted;
            font-size: Theme.font-body;
            font-weight: Theme.weight-medium;
            vertical-alignment: center;
        }
    }

    nav-touch := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

export component DarkInput inherits Rectangle {
    in-out property <string> text <=> editor.text;
    in property <string> placeholder: "";
    in property <bool> active: true;
    callback accepted(string);

    height: Theme.control-height;
    border-radius: Theme.control-radius;
    border-width: 1px;
    border-color: editor.has-focus ? Theme.accent : Theme.border-strong;
    background: Theme.canvas;


    if root.text == "": Text {
        x: 12px;
        width: parent.width - 24px;
        height: parent.height;
        text: root.placeholder;
        color: Theme.text-subtle;
        font-size: Theme.font-body;
        vertical-alignment: center;
    }

    editor := TextInput {
        x: 12px;
        width: parent.width - 24px;
        height: parent.height;
        enabled: root.active;
        color: Theme.text;
        font-size: Theme.font-body;
        font-weight: Theme.weight-normal;
        single-line: true;
        vertical-alignment: center;
        selection-background-color: Theme.accent;
        selection-foreground-color: white;
        accepted => { root.accepted(self.text); }
    }
}

export component MetricCard inherits Panel {
    in property <string> label;
    in property <string> value;
    in property <string> detail;
    in property <brush> value-color: Theme.text;

    height: 88px;
    VerticalLayout {
        padding: 12px;
        spacing: 3px;
        Text { text: root.label; color: Theme.text-muted; font-size: Theme.font-caption; font-weight: Theme.weight-bold; letter-spacing: 0.6px; }
        Text { text: root.value; color: root.value-color; font-size: Theme.font-metric; font-weight: Theme.weight-bold; }
        CaptionText { text: root.detail; overflow: elide; }
    }
}

export component StatusDot inherits Rectangle {
    in property <bool> online;
    width: 9px;
    height: 9px;
    border-radius: 5px;
    background: root.online ? Theme.success : Theme.danger;
}

export component TableCell inherits Text {
    color: Theme.text-muted;
    font-family: Theme.mono-family;
    font-size: Theme.font-body;
    font-weight: Theme.weight-medium;
    horizontal-alignment: center;
    vertical-alignment: center;
    overflow: elide;
}

export component FieldBadge inherits Rectangle {
    in property <bool> ready;
    width: ready ? 94px : 112px;
    height: 28px;
    border-radius: 14px;
    background: ready ? Theme.success-soft : Theme.surface-raised;
    Text {
        text: root.ready ? "READY" : "NOT READY";
        color: root.ready ? Theme.success : Theme.text-subtle;
        font-size: Theme.font-caption;
        font-weight: Theme.weight-bold;
        letter-spacing: 0.7px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}
